<% # Don't forget to update application.html.erb too %>
<!doctype html>
<% # Trick to make the page full height even on mobile: https://stackoverflow.com/a/24979148 %>
<html lang="<%= I18n.locale %>" class="h-full m-0">
  <head>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= display_meta_tags site: Gboolder::SITE_NAME, reverse: true %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <script async src="https://ga.jspm.io/npm:es-module-shims@1.8.2/dist/es-module-shims.js" data-turbo-track="reload"></script>
    <%= javascript_importmap_tags %>

    <% if Gboolder::PLAUSIBLE_DOMAIN.present? && !Rails.env.development? %>
      <script async defer data-domain="<%= Gboolder::PLAUSIBLE_DOMAIN %>" src="https://plausible.io/js/plausible.js" data-turbo-track="reload"></script>
    <% end %>

    <!-- FIXME: load async -->
    <%# Pin to 5.x: MapLibre 6 dropped the UMD build (dist/maplibre-gl.js), so unversioned unpkg 404s. %>
    <link href="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.css" rel="stylesheet" data-turbo-track="reload">
    <script src="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.js" data-turbo-track="reload"></script>
    <style>
      #map { position: absolute; top: 0; bottom: 0; width: 100%; }
      /* FIXME: put in css stylesheet */
      .maplibregl-popup-content {
        font-family: "Inter var", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
        font-size: 0.875rem;
      }
      .maplibregl-popup-content a {
        font-weight: 500;
        color: rgba(5, 150, 105, 1);
        text-decoration: underline;
      }

      .stack-problems-list {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 10rem;
      }

      .stack-problem-item {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        width: 100%;
        padding: 0.375rem 0;
        border: none;
        background: transparent;
        text-align: left;
        font: inherit;
        cursor: pointer;
      }

      .stack-problem-item:hover .stack-problem-item-name {
        color: rgba(5, 150, 105, 1);
        text-decoration: underline;
      }

      .stack-problem-item-name {
        font-weight: 500;
        color: #111827;
      }

      .stack-problem-item-grade {
        color: #9ca3af;
        flex-shrink: 0;
      }

      .problem-sheet-backdrop {
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 30;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
      }

      .problem-sheet-backdrop--visible {
        opacity: 1;
        pointer-events: auto;
      }

      .problem-sheet-container {
        position: fixed;
        left: 0;
        right: 0;
        top: 0;
        height: auto;
        max-height: 92vh;
        background: #ffffff;
        border-radius: 20px 20px 0 0;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
        max-width: 500px;
        margin: 0 auto;
        z-index: 40;
        display: flex;
        flex-direction: column;
        touch-action: pan-y;
        transform: translateY(100vh);
      }

      .problem-sheet-close {
        position: absolute;
        top: 4px;
        right: 4px;
        background: transparent;
        border: none;
        color: #999;
        opacity: 0.7;
        cursor: pointer;
        padding: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        z-index: 10;
      }

      .problem-sheet-close:hover {
        opacity: 1;
        background: rgba(0, 0, 0, 0.05);
      }

      .problem-sheet-handle {
        padding: 12px 0;
        cursor: grab;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
      }

      .problem-sheet-handle-bar {
        width: 36px;
        height: 5px;
        background: #999;
        opacity: 0.5;
        border-radius: 3px;
      }

      .problem-sheet-content {
        margin-top: 16px;
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
      }

      .problem-sheet-content button,
      .problem-sheet-content a {
        cursor: pointer;
      }
    </style>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>

  <body class="bg-white h-full m-0">
    <div class="bg-gray-100 flex flex-col h-full">
      <div class="flex-initial">
        <%= render "layouts/map_nav" %>
      </div>
      <%= yield %>
    </body>
  </div>
</html>
