<% set_meta_tags title: t("views.about.metas.title") %>

<% set_meta_tags og: { type: "website", image: image_url("hero-about.jpg") } %>

<main class="lg:relative bg-white">
  <div class="mx-auto w-full max-w-7xl pt-16 pb-20 text-center lg:py-48 lg:text-left">
    <div class="px-6 sm:px-8 lg:w-1/2 xl:pr-16">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:text-6xl lg:text-5xl xl:text-6xl">
        <span class="block xl:inline"><%= t("views.about.title_prefix") %></span>
        <span class="block text-emerald-600 xl:inline"><%= t("views.about.site_name") %></span>
      </h1>
    </div>
  </div>
  <div class="relative h-64 w-full sm:h-72 md:h-96 lg:absolute lg:inset-y-0 lg:right-0 lg:h-full lg:w-1/2">
    <img class="absolute inset-0 h-full w-full object-cover" src="<%= image_path "hero-about.jpg" %>" alt="">
  </div>
</main>

<div class="bg-warm-gray-50 mt-4 sm:mt-16">

  <section>
    <div class="mx-auto max-w-7xl py-8 px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-warm-gray-900">
        <%= t("views.about.project.title") %>
      </h2>

      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.project.p1") %>
      </p>

      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.project.p2_html") %>
      </p>

      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.project.p3_html", link: link_to(t("views.about.project.contact"), "mailto:#{Gboolder::CONTACT_EMAIL}", class: "font-medium underline text-emerald-600")) %>
      </p>
    </div>
  </section>

  <section id="data">
    <div class="mx-auto max-w-7xl py-8 px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-warm-gray-900">
        <%= t("views.about.data.title") %>
      </h2>
      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.data.p1_html") %>
      </p>
      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.data.p2") %>
      </p>
      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.data.p3_html") %>
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-7xl py-8 px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-warm-gray-900">
        <%= t("views.about.team.title") %>
      </h2>
      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.team.community_desc") %>
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-7xl py-8 px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-warm-gray-900">
        <%= t("views.about.open.title") %>
      </h2>
      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.open.p1_html", link: link_to("GitHub", "https://github.com/boolder-org/boolder-rails", class: "font-medium underline text-emerald-600")) %>
      </p>
      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.open.p2_html", link: link_to(t("views.about.open.contribute_link"), contribute_path, class: "font-medium underline text-emerald-600")) %>
      </p>
    </div>
  </section>

  <section id="contact">
    <div class="mx-auto max-w-7xl py-8 px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-warm-gray-900">
        <%= t("views.about.contact.title") %>
      </h2>
      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.contact.p1") %>
        <%= link_to Gboolder::CONTACT_EMAIL, "mailto:#{Gboolder::CONTACT_EMAIL}", class: "font-medium underline text-emerald-600" %>.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-7xl py-8 px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-warm-gray-900">
        <%= t("views.about.history.title") %>
      </h2>

      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.history.p1") %>
      </p>

      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.history.p2") %>
      </p>

      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.history.p3") %>
      </p>
    </div>
  </section>

  <section id="support">
    <div class="mx-auto max-w-7xl py-8 px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-warm-gray-900">
        <%= t("views.about.support.title") %>
      </h2>
      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.support.p1") %>
      </p>
      <p class="mt-6 max-w-3xl text-lg text-warm-gray-500">
        <%= t("views.about.support.p2_html",
          link_gbo: link_to("GBO", "https://gbo.crimp.se/", class: "font-medium underline text-emerald-600"),
          link_boolder: link_to("Boolder", "https://github.com/boolder-org/boolder-rails", class: "font-medium underline text-emerald-600")) %>
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-7xl py-8 px-6 lg:px-8">
    <h2 class="text-3xl font-bold tracking-tight text-warm-gray-900">
      <%= t("views.about.faq.title") %>
    </h2>
    <dl class="space-y-10 my-8">
      <div>
        <dt class="text-base font-semibold leading-7 text-gray-900">
          <%= t("views.about.faq.data.question") %>
        </dt>
        <dd class="mt-2 text-base leading-7 text-gray-600">
          <%= t("views.about.faq.data.p1") %>
          <br>
          <%= t("views.about.faq.data.p2_html", link_gbo: link_to("GBO", "https://gbo.crimp.se/", class: "font-medium underline text-emerald-600")) %>
          <br>
          <%= t("views.about.faq.data.p3") %>
        </dd>
      </div>

      <div>
        <dt class="text-base font-semibold leading-7 text-gray-900">
          <%= t("views.about.faq.why_free.question") %>
        </dt>
        <dd class="mt-2 text-base leading-7 text-gray-600">
          <%= t("views.about.faq.why_free.p1") %>
          <br>
          <%= t("views.about.faq.why_free.p2") %>
        </dd>
      </div>

      <div>
        <dt class="text-base font-semibold leading-7 text-gray-900">
          <%= t("views.about.faq.privacy.question") %>
        </dt>
        <dd class="mt-2 text-base leading-7 text-gray-600">
          <%= t("views.about.faq.privacy.p1_html", link: link_to(t("views.about.faq.privacy.policy"), privacy_path, class: "font-medium underline text-emerald-600")) %>
        </dd>
      </div>
    </dl>
  </div>

</div>
