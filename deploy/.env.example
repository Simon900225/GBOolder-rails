# Copy to .env and fill in values:
#   cp .env.example .env

# Docker image (build locally with: bin/docker-build-push)
GBOOLDER_IMAGE=simon900225/gboolder:latest

# From config/master.key on your dev machine
RAILS_MASTER_KEY=

# Postgres (used by both db and web services)
POSTGRES_PASSWORD=

# Public hostname — must match your nginx server_name
GBOOLDER_HOST=www.gboolder.example
GBOOLDER_ASSET_HOST=www.gboolder.example

# Local port for host nginx to proxy to (127.0.0.1 only)
WEB_PORT=3000

# Branding & contact
GBOOLDER_CONTACT_EMAIL=hello@gboolder.example
GBOOLDER_MAIL_FROM="GBOolder <hello@gboolder.example>"

# Admin panel HTTP Basic auth (/admin)
GBOOLDER_ADMIN_USER=admin
GBOOLDER_ADMIN_PASSWORD=

# Optional
# RAILS_LOG_LEVEL=info
# WEB_CONCURRENCY=2
# PLAUSIBLE_DOMAIN=
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
